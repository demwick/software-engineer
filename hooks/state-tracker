# PostToolUse hook for software-engineer.
# Keeps .se/state.json's last_edit timestamp fresh whenever Claude
# edits a file in a project that's already initialized with software-engineer.

set -euo pipefail

ACTION="${1:-file-touched}"

STATE_DIR=".se"
STATE_FILE="${STATE_DIR}/state.json"

# Only operate in initialized projects. In every other case, silently no-op.
[ -f "$STATE_FILE" ] || exit 0
command -v jq >/dev/null 2>&1 || exit 0

NOW=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

case "$ACTION" in
    file-touched)
        TMP=$(mktemp)
        if jq --arg ts "$NOW" '.last_edit = $ts' "$STATE_FILE" > "$TMP" 2>/dev/null; then
            mv "$TMP" "$STATE_FILE"
        else
            rm -f "$TMP"
        fi
        ;;
    verification-feedback)
        # Act feedback loop: read the latest verification result and update state.json.
        # Called after verify-phase.sh writes .se/verification/phase-<id>.json.
        # The phase id (slug or number) must match what verify-phase.sh used, or
        # we read the wrong file. Resolution order: $2 arg, .se/.verify-phase
        # marker, then state.json current_phase (number) as a last resort.
        PHASE_ID="${2:-}"
        [ -n "$PHASE_ID" ] || PHASE_ID=$(cat "${STATE_DIR}/.verify-phase" 2>/dev/null || echo "")
        [ -n "$PHASE_ID" ] || PHASE_ID=$(jq -r '.current_phase // 0' "$STATE_FILE" 2>/dev/null || echo "0")
        VERIFY_FILE="${STATE_DIR}/verification/phase-${PHASE_ID}.json"
        [ -f "$VERIFY_FILE" ] || exit 0

        VSTATUS=$(jq -r '.status // "unknown"' "$VERIFY_FILE" 2>/dev/null || echo "unknown")
        FINDINGS_COUNT=$(jq -r '.new_findings | length // 0' "$VERIFY_FILE" 2>/dev/null || echo "0")
        TDD_COMPLIANT=$(jq -r 'if .tdd_compliance.compliant == false then "false" else "true" end' "$VERIFY_FILE" 2>/dev/null || echo "true")

        TMP=$(mktemp)
        if jq \
            --arg ts "$NOW" \
            --arg vstatus "$VSTATUS" \
            --argjson findings "$FINDINGS_COUNT" \
            --argjson tdd "$TDD_COMPLIANT" \
            '.last_verification = {
                status: $vstatus,
                new_findings_count: $findings,
                tdd_compliant: $tdd,
                verified_at: $ts
            }' "$STATE_FILE" > "$TMP" 2>/dev/null; then
            mv "$TMP" "$STATE_FILE"
        else
            rm -f "$TMP"
        fi
        ;;
    *)
        echo "software-engineer state-tracker: unknown action '${ACTION}'" >&2
        ;;
esac

exit 0
