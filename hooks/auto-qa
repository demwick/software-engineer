#!/usr/bin/env bash
#
# software-engineer
# Copyright (C) 2026 demwick
# Licensed under the GNU Affero General Public License v3.0 or later.
# See LICENSE in the repository root for the full license text.
#
# Stop hook for software-engineer.
# When .se/.needs-verify exists, runs the project's test runner and
# reports failures back to Claude so it can auto-retry. Gives up after 2 retries.
#
# v2.0.0 schema: the marker and retry counter are separate files.
#   .se/.needs-verify   — existence-only flag (content ignored).
#   .se/.verify-attempts — JSON object {"attempts": N}, written atomically.
# v1 fixtures that wrote an integer into .needs-verify still work: if
# .verify-attempts is absent we fall back to reading the marker's content
# as an integer. This keeps the hook backward-compatible across the
# schema v1 → v2 migration while scripts/state-update.sh rolls state forward.

set -euo pipefail

# MAX_RETRIES rationale: two retries is the sweet spot for typical
# auto-QA failures (one fix attempt rarely finds the root cause, three
# turns the hook into a slow brute-force loop). Both the loop-protection
# give-up branch and the hard give-up branch read this constant so
# raising it in one place is enough to widen the retry window.
MAX_RETRIES=2

# TEST_TAIL_LINES rationale: tail -N of the test log is surfaced inside
# the Stop hook's block-decision reason so Claude gets actionable
# failure detail without reading the full log. 30 lines fits most stack
# traces (pytest tracebacks, Jest assertion output, Rust backtrace with
# `RUST_BACKTRACE=1`) while staying under the Stop hook decision
# payload budget. If real test suites routinely produce longer stacks,
# raise this in 10-line steps.
TEST_TAIL_LINES=30

# TEST_TIMEOUT rationale: a backstop against a test command that never
# returns (watch mode, a prompt waiting on stdin, a blocking network call) —
# without it the Stop hook hangs forever and the only recovery is kill -9.
# 300s is a ceiling, not a performance SLA: high enough not to kill a slow but
# legitimate integration suite, low enough to recover a true hang in bounded
# time. Override with SE_TEST_TIMEOUT for unusually long suites.
TEST_TIMEOUT="${SE_TEST_TIMEOUT:-300}"

STATE_DIR=".se"
MARKER="${STATE_DIR}/.needs-verify"
ATTEMPTS_FILE="${STATE_DIR}/.verify-attempts"
# Active phase id (slug or number) the flow is verifying. Kept separate from
# .needs-verify because that marker's content is reserved for the v1 retry-count
# fallback — a numeric phase id there would be misread as a retry count.
PHASE_MARKER="${STATE_DIR}/.verify-phase"
# Direct-apply scope-tripwire markers (pre-guard owns enforcement; this hook
# clears them at the end of the task so the budget doesn't leak across tasks).
DIRECT_MARKER="${STATE_DIR}/.direct-apply"
DIRECT_FILES="${STATE_DIR}/.direct-files"

# Read hook input (stdin JSON). Used to check stop_hook_active for loop protection.
INPUT=$(cat 2>/dev/null || echo "{}")

# No marker → nothing to verify, let Claude stop normally.
[ -f "$MARKER" ] || exit 0

# Require jq for safe JSON output. If missing, drop markers and exit cleanly.
if ! command -v jq >/dev/null 2>&1; then
    rm -f "$MARKER" "$ATTEMPTS_FILE" "$PHASE_MARKER" "$DIRECT_MARKER" "$DIRECT_FILES"
    exit 0
fi

# Capture the active phase id before any cleanup removes the marker.
PHASE_ID=$(cat "$PHASE_MARKER" 2>/dev/null || echo "")

STOP_ACTIVE=$(echo "$INPUT" | jq -r '.stop_hook_active // false' 2>/dev/null || echo "false")

# Read retry counter: v2 .verify-attempts first, v1 .needs-verify content fallback.
ATTEMPTS=0
if [ -f "$ATTEMPTS_FILE" ]; then
    ATTEMPTS=$(jq -r '.attempts // 0' "$ATTEMPTS_FILE" 2>/dev/null || echo "0")
else
    # v1 fallback: marker content may be an integer retry count.
    MARKER_CONTENT=$(cat "$MARKER" 2>/dev/null || echo "")
    if printf '%s' "$MARKER_CONTENT" | grep -Eq '^[0-9]+$'; then
        ATTEMPTS="$MARKER_CONTENT"
    fi
fi
ATTEMPTS=${ATTEMPTS:-0}

# Run a shell command with output to a log, bounded by TEST_TIMEOUT. Returns
# the command's exit code, or 124 (GNU `timeout` convention) if it timed out.
# Prefers timeout/gtimeout; falls back to a portable bash watchdog because
# stock macOS ships no timeout binary.
run_guarded() {
    local cmd="$1" log="$2" rc=0
    if command -v timeout >/dev/null 2>&1; then
        timeout "$TEST_TIMEOUT" sh -c "$cmd" > "$log" 2>&1 || rc=$?
        return "$rc"
    fi
    if command -v gtimeout >/dev/null 2>&1; then
        gtimeout "$TEST_TIMEOUT" sh -c "$cmd" > "$log" 2>&1 || rc=$?
        return "$rc"
    fi
    sh -c "$cmd" > "$log" 2>&1 &
    local cmd_pid=$!
    ( sleep "$TEST_TIMEOUT"; kill -KILL "$cmd_pid" 2>/dev/null ) >/dev/null 2>&1 &
    local watch_pid=$!
    local rc=0
    wait "$cmd_pid" 2>/dev/null || rc=$?
    if kill -0 "$watch_pid" 2>/dev/null; then
        # Command finished first → cancel the watchdog, return the real code.
        kill "$watch_pid" 2>/dev/null
        wait "$watch_pid" 2>/dev/null || true
        return "$rc"
    fi
    # Watchdog fired → the command was killed → timeout.
    return 124
}

# --- Verification-strategy dispatch --------------------------------------
# The flow writes the resolved phase strategy to .se/.verify-strategy when it
# arms the gate. Absent → "test", which falls through to the unchanged test
# path below (byte-for-byte the pre-resolver behavior). The non-test branches
# below handle their own clearing and retry accounting and then exit.
STRATEGY=$(tr -d '[:space:]' < "${STATE_DIR}/.verify-strategy" 2>/dev/null || echo "")
STRATEGY=${STRATEGY:-test}

clear_markers() {
    rm -f "$MARKER" "$ATTEMPTS_FILE" "$PHASE_MARKER" "$DIRECT_MARKER" "$DIRECT_FILES" "${STATE_DIR}/.verify-strategy"
}

# Increment the retry counter and emit a block, or give up past MAX_RETRIES.
# Shared by the spec-check and eval branches. The test path keeps its own
# inline counter logic, unchanged.
retry_or_giveup() {
    local reason="$1" give_up_reason="$2"
    local next=$((ATTEMPTS + 1))
    if [ "$next" -gt "$MAX_RETRIES" ]; then
        clear_markers
        jq -cn --arg r "$give_up_reason" '{decision: "block", reason: $r}'
        exit 0
    fi
    local tmp; tmp=$(mktemp)
    jq -n --argjson n "$next" '{attempts: $n}' > "$tmp"; mv "$tmp" "$ATTEMPTS_FILE"
    jq -cn --arg r "$reason" '{decision: "block", reason: $r}'
    exit 0
}

# Run scripts/spec-check.sh and clear-or-block. Used by the spec-check strategy
# and as the eval-degradation target. Graceful pass if the script is absent.
run_spec_check() {
    local label="$1"
    local script="${CLAUDE_PLUGIN_ROOT:-}/scripts/spec-check.sh"
    if [ -z "${CLAUDE_PLUGIN_ROOT:-}" ] || [ ! -f "$script" ]; then
        clear_markers
        exit 0
    fi
    local rc=0
    bash "$script" . "$PHASE_ID" >/dev/null 2>&1 || rc=$?
    # 0 = spec well-formed; 1 = uninitialized project / jq missing (graceful
    # skip). Only 2 (structural failure) is a real block.
    if [ "$rc" -eq 0 ] || [ "$rc" -eq 1 ]; then
        clear_markers
        exit 0
    fi
    retry_or_giveup \
        "Auto-QA (${label}): the phase spec is malformed or missing required structure. Read .se/verification/phase-${PHASE_ID}.json and the rules in scripts/spec-validate.sh, fix the spec's sections / acceptance criteria, and the Stop hook will re-verify." \
        "Auto-QA (${label}) gave up after ${MAX_RETRIES} retries — the spec is still malformed. Fix it and report the situation to the user."
}

case "$STRATEGY" in
    none)
        mkdir -p "$STATE_DIR"
        printf '\n=== VERIFY-SKIP: strategy=none ===\nNo verification was run for this phase (verification strategy resolved to "none").\n' \
            >> "${STATE_DIR}/.last-verify.log"
        clear_markers
        exit 0
        ;;
    spec-check)
        run_spec_check "spec-check"
        ;;
    eval)
        EVAL_CMD=""
        DETECT_EVAL="${CLAUDE_PLUGIN_ROOT:-}/scripts/detect-eval.sh"
        if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -f "$DETECT_EVAL" ]; then
            EVAL_CMD=$(bash "$DETECT_EVAL" . 2>/dev/null || true)
        fi
        if [ -z "$EVAL_CMD" ]; then
            # No eval harness → degrade to spec-check (constraint: never hard-fail).
            mkdir -p "$STATE_DIR"
            printf '\n=== VERIFY-DEGRADE: eval -> spec-check (no eval harness found) ===\n' \
                >> "${STATE_DIR}/.last-verify.log"
            run_spec_check "eval→spec-check"
        fi
        mkdir -p "$STATE_DIR"
        EVAL_LOG="${STATE_DIR}/.last-verify.log"
        EVAL_RC=0
        run_guarded "$EVAL_CMD" "$EVAL_LOG" || EVAL_RC=$?
        if [ "$EVAL_RC" -eq 124 ]; then
            clear_markers
            EVAL_TAIL=$(tail -"$TEST_TAIL_LINES" "$EVAL_LOG" 2>/dev/null || echo "")
            jq -cn --arg secs "$TEST_TIMEOUT" --arg cmd "$EVAL_CMD" --arg tail "$EVAL_TAIL" \
                '{decision: "block", reason: ("Auto-QA (eval): eval command timed out after " + $secs + "s and was killed. Command: " + $cmd + "\n\nLast output:\n" + $tail + "\n\nMake it non-interactive and bounded, then re-arm.")}'
            exit 0
        fi
        if [ "$EVAL_RC" -eq 0 ]; then
            clear_markers
            exit 0
        fi
        EVAL_TAIL=$(tail -"$TEST_TAIL_LINES" "$EVAL_LOG" 2>/dev/null || echo "")
        retry_or_giveup \
            "Auto-QA (eval): eval command failed. Command: ${EVAL_CMD}. Read the full log at .se/.last-verify.log, fix the failure, and the Stop hook will re-verify.

Last output:
${EVAL_TAIL}" \
            "Auto-QA (eval) gave up after ${MAX_RETRIES} retries — the eval suite is still failing. Review .se/.last-verify.log and report to the user."
        ;;
    test | *)
        : # fall through to the unchanged test path below
        ;;
esac
# --- end strategy dispatch -----------------------------------------------

# Loop-protection belt-and-suspenders: if the runtime is already looping AND we've
# already retried twice, give up and report the situation to the user.
if [ "$STOP_ACTIVE" = "true" ] && [ "$ATTEMPTS" -ge "$MAX_RETRIES" ]; then
    rm -f "$MARKER" "$ATTEMPTS_FILE" "$PHASE_MARKER" "$DIRECT_MARKER" "$DIRECT_FILES"
    LAST_LOG="${STATE_DIR}/.last-verify.log"
    jq -cn --arg log "$LAST_LOG" --arg max "$MAX_RETRIES" \
        '{decision: "block", reason: ("Auto-QA loop-protection tripped after " + $max + " retries — tests are still failing. Review " + $log + " and report the situation to the user. Do not keep retrying.")}'
    exit 0
fi

# Detect test runner via shared helper script.
TEST_CMD=""
DETECT_SCRIPT="${CLAUDE_PLUGIN_ROOT:-}/scripts/detect-test.sh"
if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -f "$DETECT_SCRIPT" ]; then
    TEST_CMD=$(bash "$DETECT_SCRIPT" . 2>/dev/null || true)
fi

# No detectable test runner → auto-pass, clear marker + counter.
if [ -z "$TEST_CMD" ]; then
    rm -f "$MARKER" "$ATTEMPTS_FILE" "$PHASE_MARKER" "$DIRECT_MARKER" "$DIRECT_FILES"
    exit 0
fi

# Run the tests, capturing output.
TEST_LOG="${STATE_DIR}/.last-verify.log"
mkdir -p "$STATE_DIR"

TEST_RC=0
run_guarded "$TEST_CMD" "$TEST_LOG" || TEST_RC=$?

# Timed out → retrying the identical command won't help. Give up and report.
if [ "$TEST_RC" -eq 124 ]; then
    rm -f "$MARKER" "$ATTEMPTS_FILE" "$PHASE_MARKER" "$DIRECT_MARKER" "$DIRECT_FILES"
    TIMEOUT_TAIL=$(tail -"$TEST_TAIL_LINES" "$TEST_LOG" 2>/dev/null || echo "")
    jq -cn --arg secs "$TEST_TIMEOUT" --arg cmd "$TEST_CMD" --arg tail "$TIMEOUT_TAIL" \
        '{decision: "block", reason: ("Auto-QA: test command timed out after " + $secs + "s and was killed — it likely hangs (watch mode, a prompt on stdin, or a blocking network call). Command: " + $cmd + "\n\nLast output:\n" + $tail + "\n\nDo not just re-run it: make it non-interactive and bounded (CI=1, --watch=false, --run, a test timeout) or tell the user. Re-arm and the Stop hook will re-verify.")}'
    exit 0
fi

if [ "$TEST_RC" -eq 0 ]; then
    # Tests passed. Run host-compat sanity check before letting Claude stop —
    # pyproject.toml requires-python can mismatch host Python silently while
    # pytest runs fine in a managed venv. Same for other packaging traps.
    COMPAT_SCRIPT="${CLAUDE_PLUGIN_ROOT:-}/scripts/check-host-compat.sh"
    if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -f "$COMPAT_SCRIPT" ]; then
        COMPAT_OUT=$(bash "$COMPAT_SCRIPT" . 2>/dev/null) && COMPAT_EXIT=0 || COMPAT_EXIT=$?
        if [ "$COMPAT_EXIT" = "10" ] && [ -n "$COMPAT_OUT" ]; then
            # Append to log so /se-status and humans can see it later.
            printf '\n\n=== host-compat warning ===\n%s\n' "$COMPAT_OUT" >> "$TEST_LOG"
            # Return a block so Claude fixes it now rather than shipping broken packaging.
            rm -f "$MARKER" "$ATTEMPTS_FILE" "$PHASE_MARKER" "$DIRECT_MARKER" "$DIRECT_FILES"
            jq -cn --arg msg "$COMPAT_OUT" \
                '{decision: "block", reason: ("Tests passed but host-compat check failed: " + $msg + " Fix the packaging metadata and re-run tests. Do not skip — this blocks pip install on the user host.")}'
            exit 0
        fi
    fi
    # Tests passed — run spec-based verification before clearing marker.
    # This produces .se/verification/phase-N.json for the Act feedback loop.
    VERIFY_SCRIPT="${CLAUDE_PLUGIN_ROOT:-}/scripts/verify-phase.sh"
    if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -f "$VERIFY_SCRIPT" ]; then
        bash "$VERIFY_SCRIPT" . "$PHASE_ID" 2>/dev/null || true
        # Trigger state-tracker to persist verification metadata.
        TRACKER="${CLAUDE_PLUGIN_ROOT}/hooks/state-tracker"
        if [ -f "$TRACKER" ]; then
            bash "$TRACKER" verification-feedback "$PHASE_ID" 2>/dev/null || true
        fi
    fi

    # Pass → clear marker + counter, let Claude stop.
    rm -f "$MARKER" "$ATTEMPTS_FILE" "$PHASE_MARKER" "$DIRECT_MARKER" "$DIRECT_FILES"
    exit 0
fi

# Tests failed.
NEXT=$((ATTEMPTS + 1))

if [ "$NEXT" -gt "$MAX_RETRIES" ]; then
    rm -f "$MARKER" "$ATTEMPTS_FILE" "$PHASE_MARKER" "$DIRECT_MARKER" "$DIRECT_FILES"
    jq -cn \
        --arg log "$TEST_LOG" --arg max "$MAX_RETRIES" \
        '{decision: "block", reason: ("Auto-QA gave up after " + $max + " retries — tests are still failing. Review " + $log + " and report the situation to the user. Do not keep retrying.")}'
    exit 0
fi

# Record the retry attempt atomically (temp file + mv) in .verify-attempts.
TMP_ATTEMPTS=$(mktemp)
jq -n --argjson n "$NEXT" '{attempts: $n}' > "$TMP_ATTEMPTS"
mv "$TMP_ATTEMPTS" "$ATTEMPTS_FILE"
TEST_TAIL=$(tail -"$TEST_TAIL_LINES" "$TEST_LOG" 2>/dev/null || echo "")

jq -cn \
    --arg cmd "$TEST_CMD" \
    --arg tail "$TEST_TAIL" \
    --arg n "$NEXT" \
    --arg max "$MAX_RETRIES" \
    '{
        decision: "block",
        reason: ("Auto-QA: tests failed (attempt " + $n + "/" + $max + "). Test command: " + $cmd + "\n\nLast output:\n" + $tail + "\n\nRead the full log at .se/.last-verify.log, diagnose the root cause, and fix the failing tests. The Stop hook will re-verify automatically.")
    }'
exit 0
