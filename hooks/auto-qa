#!/usr/bin/env bash
#
# software-engineer
# Copyright (C) 2026 demwick
# Licensed under the GNU Affero General Public License v3.0 or later.
# See LICENSE in the repository root for the full license text.
#
# Stop hook for software-engineer — Tier 1 of verification, every turn,
# no agent. When .se/.active is armed: run the project's test command;
# a failure blocks the stop so the model fixes it (≤ MAX_RETRIES via
# .se/.verify-attempts); a pass runs scripts/verify-phase.sh to write the
# Tier-1 record for a planned slice, then clears every marker.
#
# Markers (all cleared on every terminal state):
#   .se/.active           {"kind": "direct"|"planned", "id": ..., "files": [...]}
#   .se/.verify-attempts  {"attempts": N}  — owned by this hook
#   .se/.fixing           reproduction-test paths locked by pre-guard

set -euo pipefail

# Two retries: one attempt rarely finds the root cause, three turns the
# hook into a brute-force loop.
MAX_RETRIES=2
# Lines of test output surfaced in the block reason — enough for a stack trace.
TEST_TAIL_LINES=30
# Backstop against a test command that never returns (watch mode, stdin prompt).
TEST_TIMEOUT="${SE_TEST_TIMEOUT:-300}"

STATE_DIR=".se"
ACTIVE="${STATE_DIR}/.active"
ATTEMPTS_FILE="${STATE_DIR}/.verify-attempts"
FIXING="${STATE_DIR}/.fixing"
TEST_LOG="${STATE_DIR}/.last-verify.log"

INPUT=$(cat 2>/dev/null || echo "{}")

[ -f "$ACTIVE" ] || exit 0

clear_markers() { rm -f "$ACTIVE" "$ATTEMPTS_FILE" "$FIXING"; }

if ! command -v jq >/dev/null 2>&1; then
    clear_markers
    exit 0
fi

ID=$(jq -r '.id // ""' "$ACTIVE" 2>/dev/null || echo "")
KIND=$(jq -r '.kind // "planned"' "$ACTIVE" 2>/dev/null || echo "planned")
STOP_ACTIVE=$(echo "$INPUT" | jq -r '.stop_hook_active // false' 2>/dev/null || echo "false")
ATTEMPTS=$(jq -r '.attempts // 0' "$ATTEMPTS_FILE" 2>/dev/null || echo "0")
ATTEMPTS=${ATTEMPTS:-0}

block() { jq -cn --arg r "$1" '{decision: "block", reason: $r}'; exit 0; }

# Run a command with output to a log, bounded by TEST_TIMEOUT. Returns the
# command's exit code, or 124 on timeout. Stock macOS has no `timeout`, so a
# bash watchdog is the fallback.
run_guarded() {
    local cmd="$1" log="$2" rc=0
    if command -v timeout >/dev/null 2>&1; then
        timeout "$TEST_TIMEOUT" sh -c "$cmd" > "$log" 2>&1 || rc=$?; return "$rc"
    fi
    if command -v gtimeout >/dev/null 2>&1; then
        gtimeout "$TEST_TIMEOUT" sh -c "$cmd" > "$log" 2>&1 || rc=$?; return "$rc"
    fi
    sh -c "$cmd" > "$log" 2>&1 &
    local cmd_pid=$!
    ( sleep "$TEST_TIMEOUT"; kill -KILL "$cmd_pid" 2>/dev/null ) >/dev/null 2>&1 &
    local watch_pid=$!
    wait "$cmd_pid" 2>/dev/null || rc=$?
    if kill -0 "$watch_pid" 2>/dev/null; then
        kill "$watch_pid" 2>/dev/null; wait "$watch_pid" 2>/dev/null || true
        return "$rc"
    fi
    return 124
}

# Tier-1 record for a planned slice (verify-phase skips direct-apply).
record_and_clear() {
    local vp="${CLAUDE_PLUGIN_ROOT:-}/scripts/verify-phase.sh"
    if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -f "$vp" ]; then
        bash "$vp" . "$ID" "$KIND" 2>/dev/null || true
    fi
    clear_markers
    exit 0
}

# Loop protection: the runtime is already looping and we are out of retries.
if [ "$STOP_ACTIVE" = "true" ] && [ "$ATTEMPTS" -ge "$MAX_RETRIES" ]; then
    clear_markers
    block "Auto-QA loop-protection tripped after ${MAX_RETRIES} retries — tests are still failing. Review ${TEST_LOG} and report the situation to the user. Do not keep retrying."
fi

TEST_CMD=""
DETECT="${CLAUDE_PLUGIN_ROOT:-}/scripts/detect-test.sh"
if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -f "$DETECT" ]; then
    TEST_CMD=$(bash "$DETECT" . 2>/dev/null || true)
fi

# No runner: nothing to run, but a planned slice still gets its record.
[ -n "$TEST_CMD" ] || record_and_clear

mkdir -p "$STATE_DIR"
TEST_RC=0
run_guarded "$TEST_CMD" "$TEST_LOG" || TEST_RC=$?

if [ "$TEST_RC" -eq 124 ]; then
    clear_markers
    TAIL=$(tail -"$TEST_TAIL_LINES" "$TEST_LOG" 2>/dev/null || echo "")
    block "Auto-QA: test command timed out after ${TEST_TIMEOUT}s and was killed — it likely hangs (watch mode, a prompt on stdin, a blocking network call). Command: ${TEST_CMD}

Last output:
${TAIL}

Make it non-interactive and bounded (CI=1, --watch=false, --run, a test timeout) or tell the user. Re-arm and the Stop hook will re-verify."
fi

if [ "$TEST_RC" -eq 0 ]; then
    # Packaging can be wrong while tests pass in a managed venv.
    COMPAT="${CLAUDE_PLUGIN_ROOT:-}/scripts/check-host-compat.sh"
    if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -f "$COMPAT" ]; then
        COMPAT_OUT=$(bash "$COMPAT" . 2>/dev/null) && COMPAT_RC=0 || COMPAT_RC=$?
        if [ "$COMPAT_RC" = "10" ] && [ -n "$COMPAT_OUT" ]; then
            printf '\n\n=== host-compat warning ===\n%s\n' "$COMPAT_OUT" >> "$TEST_LOG"
            clear_markers
            block "Tests passed but host-compat check failed: ${COMPAT_OUT} Fix the packaging metadata and re-run tests — this blocks install on the user's host."
        fi
    fi
    record_and_clear
fi

# Tests failed.
NEXT=$((ATTEMPTS + 1))
if [ "$NEXT" -gt "$MAX_RETRIES" ]; then
    clear_markers
    block "Auto-QA gave up after ${MAX_RETRIES} retries — tests are still failing. Review ${TEST_LOG} and report the situation to the user. Do not keep retrying."
fi

TMP=$(mktemp)
jq -n --argjson n "$NEXT" '{attempts: $n}' > "$TMP"
mv "$TMP" "$ATTEMPTS_FILE"
TAIL=$(tail -"$TEST_TAIL_LINES" "$TEST_LOG" 2>/dev/null || echo "")
block "Auto-QA: tests failed (attempt ${NEXT}/${MAX_RETRIES}). Test command: ${TEST_CMD}

Last output:
${TAIL}

Read the full log at ${TEST_LOG}, diagnose the root cause, and fix the code (not the test). The Stop hook will re-verify automatically."
