#!/usr/bin/env bash
#
# software-engineer
# Copyright (C) 2026 demwick
# Licensed under the GNU Affero General Public License v3.0 or later.
# See LICENSE in the repository root for the full license text.
#
# PreToolUse hook for software-engineer — the deterministic layer behind
# the flows. Active only in SE-managed projects (.se/state.json exists).
#
#   Bash        — blocks irreversible git/db operations. Detect & Defer:
#                 silent when claude-charter is present (charter owns it).
#
#   Write|Edit  — three gates on paths under the project root:
#     1. Edit gate: blocked unless .se/.active is armed. The flows arm it
#        after the plan exists (planned) or the size check (direct). This
#        is "no code without a plan", enforced rather than asked for.
#        Flow-owned paths stay open: .se/, CLAUDE.md, .gitignore, .claude/.
#     2. Direct tripwire: with kind=direct, the 4th distinct file is
#        blocked — triage misrouted a larger task; escalate to a plan.
#     3. Fixing lock: paths listed in .se/.fixing (reproduction tests
#        committed red) cannot be edited until the fix lands.
#
# Blocking contract: exit 2 with the reason on stderr denies the call and
# feeds the reason to the model. Every other failure path exits 0 — a
# guard bug must never break a working session.

set -uo pipefail

DIRECT_MAX_FILES=3
STATE_DIR=".se"
STATE_FILE="${STATE_DIR}/state.json"
ACTIVE="${STATE_DIR}/.active"
FIXING="${STATE_DIR}/.fixing"

INPUT=$(cat 2>/dev/null || echo "{}")

command -v jq >/dev/null 2>&1 || exit 0
[ -f "$STATE_FILE" ] || exit 0

TOOL=$(printf '%s' "$INPUT" | jq -r '.tool_name // ""' 2>/dev/null || echo "")

case "$TOOL" in
    Bash)
        if [ -d ".claude/knowledge/charter" ]; then exit 0; fi
        if [ "$(jq -r '.integrations.charter // false' "$STATE_FILE" 2>/dev/null || echo false)" = "true" ]; then
            exit 0
        fi

        CMD=$(printf '%s' "$INPUT" | jq -r '.tool_input.command // ""' 2>/dev/null || echo "")
        [ -n "$CMD" ] || exit 0

        REASON=""
        if printf '%s' "$CMD" | grep -Eq 'git[[:space:]]+push([[:space:]]+[^|;&]*)?[[:space:]]+(--force-with-lease|--force|-f)\b'; then
            REASON="force-push rewrites published history"
        elif printf '%s' "$CMD" | grep -Eq 'git[[:space:]]+push([[:space:]]+[^|;&]*)?[[:space:]]+--delete\b'; then
            REASON="git push --delete removes a remote ref"
        elif printf '%s' "$CMD" | grep -Eq 'git[[:space:]]+reset[[:space:]]+--hard'; then
            REASON="git reset --hard discards uncommitted work"
        elif printf '%s' "$CMD" | grep -Eq 'git[[:space:]]+clean[[:space:]]+-[a-z]*f'; then
            REASON="git clean -f deletes untracked files irreversibly"
        elif printf '%s' "$CMD" | grep -Eq 'git[[:space:]]+branch[[:space:]]+(-D|--delete[[:space:]]+--force|-[a-zA-Z]*D)'; then
            REASON="git branch -D force-deletes a branch"
        elif printf '%s' "$CMD" | grep -Eq 'git[[:space:]]+tag[[:space:]]+-d'; then
            REASON="git tag -d deletes a tag"
        elif printf '%s' "$CMD" | grep -Eiq '\b(DROP[[:space:]]+(TABLE|DATABASE|SCHEMA)|TRUNCATE[[:space:]]+TABLE)\b'; then
            REASON="a destructive SQL statement (DROP/TRUNCATE) is irreversible"
        elif printf '%s' "$CMD" | grep -Eq 'rm[[:space:]]+-[a-z]*r[a-z]*f|rm[[:space:]]+-[a-z]*f[a-z]*r'; then
            if printf '%s' "$CMD" | grep -Evq 'node_modules|/dist|/build|/target|\.venv|__pycache__|\.pytest_cache|/coverage|\.next|\.turbo'; then
                REASON="rm -rf on a non-cache path can destroy work"
            fi
        fi

        if [ -n "$REASON" ]; then
            printf 'software-engineer guard: blocked an irreversible command (%s).\nCommand: %s\nIf this is intended, ask the user to run it themselves with the `!` prefix, or confirm explicitly before proceeding.\n' \
                "$REASON" "$CMD" >&2
            exit 2
        fi
        exit 0
        ;;

    Write|Edit)
        FP=$(printf '%s' "$INPUT" | jq -r '.tool_input.file_path // ""' 2>/dev/null || echo "")
        [ -n "$FP" ] || exit 0

        ROOT="$PWD"
        case "$FP" in
            /*)
                case "$FP" in
                    "$ROOT"/*) REL="${FP#"$ROOT"/}" ;;
                    *) exit 0 ;;   # outside the project — not ours to gate
                esac
                ;;
            *) REL="${FP#./}" ;;
        esac

        # Flow-owned paths are always open.
        case "$REL" in
            .se/*|CLAUDE.md|.gitignore|.claude/*) exit 0 ;;
        esac

        # 3. Fixing lock.
        if [ -f "$FIXING" ] && grep -Fxq "$REL" "$FIXING" 2>/dev/null; then
            printf 'software-engineer guard: %s is a reproduction test locked by .se/.fixing.\nThe fix goes into the code, not the test. Make the test pass by changing the implementation; if the test itself is wrong, say so to the user instead of editing it. The executor removes .se/.fixing after the fix commit.\n' "$REL" >&2
            exit 2
        fi

        # 1. Edit gate.
        if [ ! -f "$ACTIVE" ]; then
            printf 'software-engineer guard: no active SE work — edits to %s are gated.\nThis project is managed by software-engineer: every change starts with triage (describe the work), which writes the plan (or confirms the task is direct) and arms .se/.active before the executor edits. Run the flow; do not write the marker by hand to bypass the gate.\n' "$REL" >&2
            exit 2
        fi

        # 2. Direct tripwire.
        KIND=$(jq -r '.kind // ""' "$ACTIVE" 2>/dev/null || echo "")
        [ "$KIND" = "direct" ] || exit 0
        if jq -e --arg f "$REL" '.files | index($f)' "$ACTIVE" >/dev/null 2>&1; then exit 0; fi
        COUNT=$(jq -r '.files | length' "$ACTIVE" 2>/dev/null || echo 0)
        if [ $((COUNT + 1)) -gt "$DIRECT_MAX_FILES" ]; then
            printf 'software-engineer guard: direct-apply scope exceeded (%s distinct files, limit %s).\nThis task touches more files than a direct task should — triage misrouted it. Stop and escalate to a planned slice (skills/triage/references/flow-light.md): write the plan, then resume.\n' \
                "$((COUNT + 1))" "$DIRECT_MAX_FILES" >&2
            exit 2
        fi
        TMP=$(mktemp)
        if jq --arg f "$REL" '.files += [$f]' "$ACTIVE" > "$TMP" 2>/dev/null; then mv "$TMP" "$ACTIVE"; else rm -f "$TMP"; fi
        exit 0
        ;;

    *) exit 0 ;;
esac
