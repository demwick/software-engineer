# SessionStart hook for software-engineer.
# Reads .se/state.json + roadmap.md and injects a short "you are here"
# block via hookSpecificOutput. Clears gate markers an interrupted turn
# left behind — a new session never inherits an armed gate.

set -uo pipefail

STATE_DIR=".se"

emit_empty() {
    printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":""}}\n'
    exit 0
}

# Clear the gate markers BEFORE the injection guard. pre-guard treats a
# project as managed on state.json alone, and light-plan and direct-apply
# never write roadmap.md — so gating cleanup on both files meant those
# projects inherited an armed .se/.active from an interrupted turn, and the
# next session's first edit sailed through the gate with no triage. The
# injection needs a roadmap to describe; the cleanup needs only a project.
# Clearing a permission marker is not the same as forgetting the work it was
# armed for. The marker is a per-turn grant and must not survive the session;
# the slice it belonged to may be half-finished, and a new session that says
# nothing about it is how a half-finished slice gets started over.
INTERRUPTED=""
if [ -f "${STATE_DIR}/state.json" ]; then
    if [ -f "${STATE_DIR}/.active" ] && command -v jq >/dev/null 2>&1; then
        INTERRUPTED=$(jq -r '.id // ""' "${STATE_DIR}/.active" 2>/dev/null || echo "")
    fi
    rm -f "${STATE_DIR}/.active" "${STATE_DIR}/.fixing" "${STATE_DIR}/.verify-attempts" 2>/dev/null || true
fi

# state.json alone makes a project managed — the same bar pre-guard uses, and
# the same reason the marker cleanup above does not ask for a roadmap. A
# project built from ad-hoc planned slices never writes roadmap.md, and gating
# the whole report on one meant those projects were told nothing at all about
# work left half-finished. The roadmap-derived lines degrade instead.
[ -f "${STATE_DIR}/state.json" ] || emit_empty

command -v jq >/dev/null 2>&1 || emit_empty

# What is half-done, from the artifacts rather than from a marker: progress the
# executor recorded per task, and verification that never reached a close.
# The marker named the slice the last turn was armed for. Reading it before
# clearing it is the whole point; saying so is what makes the clear visible.
MARKER_LINE=""
[ -n "$INTERRUPTED" ] && MARKER_LINE="
- The last session ended with slice ${INTERRUPTED} still armed. Its gate marker was cleared; arming comes first if you resume it"

RESUME_LINES=""
for pf in "${STATE_DIR}"/plans/*.progress.json; do
    [ -f "$pf" ] || continue
    pid=$(jq -r '.id // ""' "$pf" 2>/dev/null || echo "")
    ptask=$(jq -r '.current_task // "?"' "$pf" 2>/dev/null || echo "?")
    pdone=$(jq -r '(.completed_tasks // []) | length' "$pf" 2>/dev/null || echo 0)
    [ -n "$pid" ] || continue
    RESUME_LINES="${RESUME_LINES}
- Unfinished slice ${pid}: on task ${ptask}, ${pdone} committed. Its plan is .se/plans/${pid}.md"
done
for vf in "${STATE_DIR}"/verification/*.json; do
    [ -f "$vf" ] || continue
    case "$vf" in *.review.json|*.closed.json|*.accepted.json) continue ;; esac
    vid=$(jq -r '.id // ""' "$vf" 2>/dev/null || echo "")
    vst=$(jq -r '.status // ""' "$vf" 2>/dev/null || echo "")
    [ -n "$vid" ] || continue
    [ -f "${STATE_DIR}/verification/${vid}.closed.json" ] && continue
    case "$vst" in
        pass)
            if [ -f "${STATE_DIR}/verification/${vid}.review.json" ]; then
                # Reviewed, and the turn ended before the close ran — but what
                # to do next depends on the verdict. Telling the user to close a
                # slice whose review failed sends them into a refusal.
                rvd=$(jq -r '.status // ""' "${STATE_DIR}/verification/${vid}.review.json" 2>/dev/null || echo "")
                case "$rvd" in
                    pass) RESUME_LINES="${RESUME_LINES}
- Slice ${vid} is verified and reviewed clean but never closed. Run state-update.sh --close-slice ${vid}" ;;
                    partial) RESUME_LINES="${RESUME_LINES}
- Slice ${vid} reviewed partial and is not closed. Fix the findings and re-review, or close it with --accept-risk once the user accepts them" ;;
                    fail) RESUME_LINES="${RESUME_LINES}
- Slice ${vid} reviewed FAIL and is not closed. Its findings come first; the close refuses until a re-review is clean" ;;
                    *) RESUME_LINES="${RESUME_LINES}
- Slice ${vid} has a review this cannot read (${rvd:-no status}) and is not closed. Re-run the verifier" ;;
                esac
            else
                RESUME_LINES="${RESUME_LINES}
- Slice ${vid} passed Tier 1 and has no review yet. Run the verifier, then close it"
            fi
            ;;
        fail|incomplete) RESUME_LINES="${RESUME_LINES}
- Slice ${vid} is recorded ${vst} and is not closed. Re-run its checks before anything else" ;;
    esac
done

MODE=$(jq -r '.mode // "unknown"' "${STATE_DIR}/state.json" 2>/dev/null || echo "unknown")
CURRENT=$(jq -r '.current_phase // 1' "${STATE_DIR}/state.json" 2>/dev/null || echo "1")
TOTAL=$(jq -r '.total_phases // 0' "${STATE_DIR}/state.json" 2>/dev/null || echo "0")
LAST_COMMIT=$(jq -r '.last_commit // "none"' "${STATE_DIR}/state.json" 2>/dev/null || echo "none")
LAST_SESSION=$(jq -r '.last_session // "never"' "${STATE_DIR}/state.json" 2>/dev/null || echo "never")
CURRENT_STEP=$(jq -r '.current_step // ""' "${STATE_DIR}/state.json" 2>/dev/null || echo "")

# Detect & Defer: charter owns ADR location, destructive-op guardrails and
# the verdict format; centaur owns acceptance-time diff-risk scoring.
CHARTER=false
if [ -d ".claude/knowledge/charter" ]; then CHARTER=true; fi
CENTAUR=false
if [ -d ".claude/knowledge/centaur" ] || [ -f ".se/.centaur" ]; then CENTAUR=true; fi

if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
    bash "${CLAUDE_PLUGIN_ROOT}/scripts/state-update.sh" \
        integrations="{\"charter\":${CHARTER},\"centaur\":${CENTAUR}}" >/dev/null 2>&1 || true
fi

STEP_LINE=""
[ -n "${CURRENT_STEP}" ] && STEP_LINE="
- Current step: ${CURRENT_STEP}"

# The roadmap lines are the roadmap's. A project built from ad-hoc planned
# slices has no phases, and "Phase 0 of 0 / <unnamed>" is noise that reads like
# a broken install.
PHASE_LINES=""
if [ -f "${STATE_DIR}/roadmap.md" ] && [ "${TOTAL}" != "0" ]; then
    PHASE_NAME=$(grep -E "^### Phase ${CURRENT}[:.)[:space:]-]" "${STATE_DIR}/roadmap.md" 2>/dev/null | head -1 | sed -E 's/^### Phase [0-9]+[:.)]?[[:space:]]*//' || echo "")
    [ -z "${PHASE_NAME}" ] && PHASE_NAME="<unnamed>"
    PHASE_LINES="
- Progress: Phase ${CURRENT} of ${TOTAL}
- Active phase: ${PHASE_NAME}"
fi

CONTEXT=$(cat <<EOF
<software-engineer-session-state>
This project is managed by software-engineer.

Current state:
- Mode: ${MODE}${PHASE_LINES}
- Last session: ${LAST_SESSION}
- Last commit: ${LAST_COMMIT}${STEP_LINE}
- Ecosystem: charter=${CHARTER}, centaur=${CENTAUR}${MARKER_LINE}${RESUME_LINES}

Every engineering request goes through the triage skill: it decides the
depth (direct / planned slice / full flow), writes the artifacts under
.se/ (intent, spec, plan), arms the edit gate, runs the executor, and
verifies. A Write/Edit to project code while no work is armed is blocked
by the PreToolUse guard — that block means "run triage", not "bypass".

Artifacts (committed): .se/intent/, .se/specs/, .se/plans/, .se/adr/,
.se/verification/, .se/roadmap.md. "continue" advances the active phase.

Read-only helpers: /se-status (where am I), /se-diagnose (health audit).
Roadmap edits: ask in plain language — triage edits .se/roadmap.md.

Detect & Defer: charter=true → ADRs go to .claude/knowledge/adr/, the
destructive-op guard defers to charter, the verifier uses the charter
PASS/FAIL/PARTIAL verdict. centaur=true → acceptance-time diff-risk
belongs to centaur; the plugin risk role stays forward-looking (the plan Risks section).

An unfinished slice listed above is resumable: the plan and the progress file
say where it stopped, and a close refuses until its evidence is current again.
The gate markers were cleared with the last session, so arming comes first.

Do not mention this block unless the user asks about software-engineer state.
</software-engineer-session-state>
EOF
)

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$(escape_for_json "$CONTEXT")"
exit 0
