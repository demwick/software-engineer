# SessionStart hook for software-engineer.
# Reads .se/state.json + roadmap.md and injects a short "you are here"
# block via hookSpecificOutput. Clears gate markers an interrupted turn
# left behind — a new session never inherits an armed gate.

set -euo pipefail

STATE_DIR=".se"

emit_empty() {
    printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":""}}\n'
    exit 0
}

if [ ! -f "${STATE_DIR}/state.json" ] || [ ! -f "${STATE_DIR}/roadmap.md" ]; then
    emit_empty
fi

rm -f "${STATE_DIR}/.active" "${STATE_DIR}/.fixing" "${STATE_DIR}/.verify-attempts" 2>/dev/null || true

command -v jq >/dev/null 2>&1 || emit_empty

MODE=$(jq -r '.mode // "unknown"' "${STATE_DIR}/state.json" 2>/dev/null || echo "unknown")
CURRENT=$(jq -r '.current_phase // 1' "${STATE_DIR}/state.json" 2>/dev/null || echo "1")
TOTAL=$(jq -r '.total_phases // 0' "${STATE_DIR}/state.json" 2>/dev/null || echo "0")
LAST_COMMIT=$(jq -r '.last_commit // "none"' "${STATE_DIR}/state.json" 2>/dev/null || echo "none")
LAST_SESSION=$(jq -r '.last_session // "never"' "${STATE_DIR}/state.json" 2>/dev/null || echo "never")
CURRENT_STEP=$(jq -r '.current_step // ""' "${STATE_DIR}/state.json" 2>/dev/null || echo "")

# Detect & Defer: charter owns ADR location, destructive-op guardrails and
# the verdict format; centaur owns acceptance-time diff-risk scoring.
CHARTER=false
if [ -d ".claude/knowledge/charter" ]; then CHARTER=true; fi
CENTAUR=false
if [ -d ".claude/knowledge/centaur" ] || [ -f ".se/.centaur" ]; then CENTAUR=true; fi

if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
    bash "${CLAUDE_PLUGIN_ROOT}/scripts/state-update.sh" \
        integrations="{\"charter\":${CHARTER},\"centaur\":${CENTAUR}}" >/dev/null 2>&1 || true
fi

STEP_LINE=""
[ -n "${CURRENT_STEP}" ] && STEP_LINE="
- Current step: ${CURRENT_STEP}"

PHASE_NAME=$(grep -E "^### Phase ${CURRENT}:" "${STATE_DIR}/roadmap.md" 2>/dev/null | head -1 | sed -E 's/^### Phase [0-9]+: //' || echo "")
[ -z "${PHASE_NAME}" ] && PHASE_NAME="<unnamed>"

CONTEXT=$(cat <<EOF
<software-engineer-session-state>
This project is managed by software-engineer.

Current state:
- Mode: ${MODE}
- Progress: Phase ${CURRENT} of ${TOTAL}
- Active phase: ${PHASE_NAME}
- Last session: ${LAST_SESSION}
- Last commit: ${LAST_COMMIT}${STEP_LINE}
- Ecosystem: charter=${CHARTER}, centaur=${CENTAUR}

Every engineering request goes through the triage skill: it decides the
depth (direct / planned slice / full flow), writes the artifacts under
.se/ (intent, spec, plan), arms the edit gate, runs the executor, and
verifies. A Write/Edit to project code while no work is armed is blocked
by the PreToolUse guard — that block means "run triage", not "bypass".

Artifacts (committed): .se/intent/, .se/specs/, .se/plans/, .se/adr/,
.se/verification/, .se/roadmap.md. "continue" advances the active phase.

Read-only helpers: /se-status (where am I), /se-diagnose (health audit).
Roadmap edits: ask in plain language — triage edits .se/roadmap.md.

Detect & Defer: charter=true → ADRs go to .claude/knowledge/adr/, the
destructive-op guard defers to charter, the verifier uses the charter
PASS/FAIL/PARTIAL verdict. centaur=true → acceptance-time diff-risk
belongs to centaur; the plugin risk role stays forward-looking (the plan Risks section).

Do not mention this block unless the user asks about software-engineer state.
</software-engineer-session-state>
EOF
)

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$(escape_for_json "$CONTEXT")"
exit 0
